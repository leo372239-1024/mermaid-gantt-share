# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
#
# 生成一个随机管理员口令：
#   node -e "console.log(require('crypto').randomBytes(6).toString('base64url'))"

# Web 服务端口（建议留在 15001–49151，避开系统动态端口池）
APP_PORT=18080

# PostgreSQL 宿主机映射端口
DB_PORT=15432

# 管理员口令：登录后才能在网页上增删改事件
ADMIN_PASSWORD=改成你自己的口令

# 登录令牌有效期（可选，默认「永不过期」）
#   留空 / 不写此变量 / 写 0 / 写无法识别的值  → 永不过期（推荐，本机自用）
#   写正数则定期过期，单位支持 ms/s/m/h/d，纯数字按「秒」计：
#     TOKEN_TTL=12h    12 小时后过期
#     TOKEN_TTL=7d     7 天后过期
#     TOKEN_TTL=3600   3600 秒（1 小时）后过期
#   改完需 `docker compose up -d`（env 变化会自动重建容器，无需 --build）。
#   注意：无论有效期设成什么，**换 ADMIN_PASSWORD 都会让所有旧令牌立即失效**
#   —— 签名密钥由口令派生，这是「令牌作废」的唯一通道。
#TOKEN_TTL=12h

# 数据库口令（内部使用）
DB_PASSWORD=改成你自己的口令
